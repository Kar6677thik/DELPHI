#!/bin/sh
# Rejects AI/co-author attribution in commit messages (docs/24-engineering-conventions.md §5).
# Enable once per clone:  git config core.hooksPath .githooks
# Same pattern as the commit-policy CI job (.github/workflows/policy.yml); keep the two in sync.
if grep -qiE '^co-authored-by:|generated (with|by) \[?claude' "$1"; then
  echo "commit-msg: attribution trailers are not allowed in this repository (see AGENTS.md §2)." >&2
  exit 1
fi
