  "components": {
    "schemas": {
      "AuditVerifyView": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "checked": {
            "type": "integer",
            "title": "Checked"
          },
          "first_bad_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Bad Id"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "checked"
        ],
        "title": "AuditVerifyView"
      },
      "CheckStatus": {
        "type": "string",
        "enum": [
          "ok",
          "failed"
        ],
        "title": "CheckStatus"
      },
      "CheckView": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CheckView"
      },
      "CreateUser": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{3,64}$",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Display Name"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "username",
          "display_name",
          "password",
          "role"
        ],
        "title": "CreateUser"
      },
      "DatasetRequest": {
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "test",
              "demo",
              "eval"
            ],
            "title": "Profile"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9.223372036854776e+18,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "default: the profile's"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile"
        ],
        "title": "DatasetRequest"
      },
      "DiffOp": {
        "type": "string",
        "enum": [
          "added",
          "removed",
          "changed"
        ],
        "title": "DiffOp"
      },
      "HealthView": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          }
        },
        "type": "object",
        "required": [
