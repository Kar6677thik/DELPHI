{
  "openapi": "3.1.0",
  "info": {
    "title": "DELPHI",
    "version": "dev"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Health",
        "description": "Liveness and startup probe. Never touches the database, so a database outage does not\ncause restart loops.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthView"
                }
              }
            }
          },
          "default": {
            "description": "An RFC 9457 problem (docs/16 §1)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Ready",
        "operationId": "ready_api_v1_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessView"
                }
              }
            }
          },
          "default": {
            "description": "An RFC 9457 problem (docs/16 §1)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "One or more checks failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/stream": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Stream",
        "operationId": "stream_api_v1_events_stream_get",
        "parameters": [
          {
            "name": "topics",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated topics",
              "title": "Topics"
            },
            "description": "Comma-separated topics"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An SSE stream",
            "content": {
              "text/event-stream": {}
            }
          },
          "default": {
            "description": "An RFC 9457 problem (docs/16 §1)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckStatus": {
        "type": "string",
        "enum": [
          "ok",
          "failed"
        ],
        "title": "CheckStatus"
      },
      "CheckView": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CheckView"
      },
      "HealthView": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "started_at"
        ],
        "title": "HealthView"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "instance": {
            "type": "string",
            "title": "Instance"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProblemFieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "instance",
          "request_id"
        ],
        "title": "Problem",
        "description": "The body of every error response: RFC 9457 plus the stable ``code`` (docs/16 §1)."
      },
      "ProblemCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "CSRF_REJECTED",
          "NOT_FOUND",
          "IDEMPOTENCY_CONFLICT",
          "INVALID_STATE_TRANSITION",
          "VERSION_CONFLICT",
          "RATE_LIMITED",
          "INVALID_CLIENT_SIGNALS",
          "PROBE_NOT_AWAITING",
          "KB_VALIDATION_FAILED",
          "FOUR_EYES_REQUIRED",
          "SHADOW_INSUFFICIENT",
          "KB_STALE_PARENT",
          "JOB_ALREADY_RUNNING",
          "NOT_INITIALISED",
          "INTERNAL"
        ],
        "title": "ProblemCode"
      },
      "ProblemFieldError": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "path",
          "code",
          "message"
        ],
        "title": "ProblemFieldError"
      },
      "ReadinessView": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckView"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessView"
      }
    }
  }
}
