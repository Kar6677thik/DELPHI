    "/api/v1/health": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Health",
        "description": "Liveness and startup probe. Never touches the database, so a database outage does not\ncause restart loops.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthView"
                }
              }
            }
          },
          "default": {
            "description": "An RFC 9457 problem (docs/16 §1)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
